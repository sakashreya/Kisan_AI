from faster_whisper import WhisperModel
from .config import WHISPER_MODEL

_model = None


def _get():
    global _model
    if _model is None:
        # int8 on CPU is fine for dev. On a GPU use device="cuda", compute_type="float16"
        _model = WhisperModel(WHISPER_MODEL, device="cpu", compute_type="int8")
    return _model


def transcribe(path: str, language_hint: str | None = None):
    """Returns (text, detected_language_code)."""
    segments, info = _get().transcribe(path, beam_size=5, language=language_hint, vad_filter=True)
    text = " ".join(seg.text.strip() for seg in segments).strip()
    return text, info.language
